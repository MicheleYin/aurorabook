{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/ensure-windows-ort-dlls.cjs --arch=arm64"
  },
  "bundle": {
    "targets": ["nsis"],
    "resources": [
      "resources/voice-samples/",
      "resources/supertonic/onnx/",
      "resources/supertonic/voice_styles/",
      "resources/ort-dylibs/",
      "resources/ffmpeg-bin/"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/nsis-hooks.nsh"
      }
    }
  }
}
