{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    { "identifier": "fs:scope", "allow": [{ "path": "$APPLOCALDATA/tts-tauri/**" }] },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "$APPLOCALDATA/tts-tauri/**" }] },
    { "identifier": "fs:allow-read", "allow": [{ "path": "$APPLOCALDATA/tts-tauri/**" }] },
    { "identifier": "fs:allow-read-file", "allow": [{ "path": "$APPLOCALDATA/tts-tauri/**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "$APPLOCALDATA/tts-tauri/**" }] },
    "store:default",
    "opener:default"
  ]
}
