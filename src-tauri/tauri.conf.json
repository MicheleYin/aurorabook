{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraBook",
  "version": "2.0.16",
  "identifier": "com.micheleyin.aurorabook",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/voice-samples/",
      "resources/supertonic/onnx/",
      "resources/supertonic/voice_styles/"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": "Entitlements.macos-appstore.plist"
    },
    "iOS": {
      "developmentTeam": "YOUR_TEAM_ID",
      "frameworks": [],
      "minimumSystemVersion": "15.1"
    }
  }
}