{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraBook",
  "version": "1.3.1",
  "identifier": "com.micheleyin.aurorabook",
"build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/kokoro-v1.0.onnx",
      "resources/voices-v1.0.bin",
      "resources/voice-samples/**/*.mp3",
      "resources/espeak-ng-data/"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.0",
      "exceptionDomain": "",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": "gen/apple/aurorabook_macOS/aurorabook_macOS.entitlements"
    },
    "iOS": {
      "developmentTeam": "YOUR_DEVELOPMENT_TEAM_ID",
      "frameworks": [],
      "minimumSystemVersion": "15.1"
    }
  }
}
