{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuroraBook",
  "version": "0.1.0",
  "identifier": "com.bigemperor26.tauri",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuroraBook",
        "width": 800,
        "height": 600,
        "minWidth": 300,
        "minHeight": 300,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/kokoro-v1.0.onnx",
      "resources/voices-v1.0.bin",
      "resources/voice-samples/**/*.mp3"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": "Apple Development: Michele Yin (YOUR_OLD_TEAM_ID)"
    }
  }
}
