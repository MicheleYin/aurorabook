{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tts-tauri",
  "version": "0.1.0",
  "identifier": "com.bigemperor26.tauri",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tts-tauri",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/kokoro-v1.0.onnx",
      "resources/voices-v1.0.bin",
      "resources/kokoro_duration.mlpackage",
      "resources/kokoro_decoder_only_3s.mlpackage",
      "resources/kokoro_decoder_only_5s.mlpackage",
      "resources/kokoro_decoder_only_10s.mlpackage",
      "resources/kokoro_synthesizer_3s.mlpackage",
      "resources/kokoro_synthesizer_3s_nolstm.mlpackage",
      "resources/kokoro_f0n_3s.mlpackage"
    ]
  }
}
