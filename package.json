{
  "name": "aurorabook",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:debug": "RUST_LOG=debug bun tauri dev",
    "dev:trace": "RUST_LOG=trace bun tauri dev",
    "dev:smil": "RUST_LOG=aurorabook::epub::converter::smil=debug,aurorabook::book_service=debug,aurorabook=info,info bun tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:macos": "bun run build && bun tauri build && ./sign_app.sh",
    "build:macos:universal": "bun run build && bun tauri build --target universal-apple-darwin && ./sign_app.sh",
    "build:macos:unsigned": "bun run build && bun tauri build",
    "build:onnxruntime:ios": "./scripts/build-onnxruntime-ios.sh",
    "build:ios": "bun run build && bun tauri ios build --target aarch64",
    "build:ios:sim": "bun run build && bun tauri ios build --target aarch64-sim",
    "build:ios:debug": "bun run build && bun tauri ios build --target aarch64 --debug",
    "build:ios:sim:debug": "bun run build && bun tauri ios build --target aarch64-sim --debug",
    "build:ios:full": "bun run build:onnxruntime:ios && bun run build:ios",
    "ios:xcode": "open src-tauri/gen/apple/aurorabook.xcodeproj",
    "test:playwright": "playwright test",
    "test:zip-epub": "./scripts/zip-to-epub.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\""
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.11.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "epubjs": "^0.3.93",
    "lamejs": "^1.2.1",
    "lru-cache": "^11.2.2",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^2.9.4",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.22",
    "bits-ui": "^1.4.7",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "mode-watcher": "^1.0.6",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-sort-imports": "^1.8.9",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.0.3"
  }
}
